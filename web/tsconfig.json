{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "noEmit": true, "skipLibCheck": true, "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "isolatedModules": true
  },
  "include": ["src"]
}
