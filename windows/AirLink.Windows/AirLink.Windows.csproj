<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AirLink</AssemblyName>
    <RootNamespace>AirLink.Windows</RootNamespace>
    <Version>0.11.0</Version>
    <AssemblyVersion>0.11.0.0</AssemblyVersion>
    <FileVersion>0.11.0.0</FileVersion>
    <Product>AirLink</Product>
    <Description>Local, encrypted file transfers.</Description>
    <Company>lucasfd3</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/AirLink.ico</ApplicationIcon>
    <StartupObject>AirLink.Windows.Program</StartupObject>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Copyright>Copyright © 2026 lucasfd3</Copyright>
    <PathMap>$(MSBuildProjectDirectory)=/AirLink/windows/AirLink.Windows</PathMap>
    <!-- WPF owns per-monitor DPI through app.manifest; Windows Forms is used only for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NetSparkleUpdater.UI.WPF" Version="3.1.0" />
    <ProjectReference Include="../AirLink.Core/AirLink.Core.csproj" />
    <EmbeddedResource Include="Assets/AirLink.ico" LogicalName="AirLink.Windows.Icon" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="AirLink.Windows.License" />
    <EmbeddedResource Include="$(AirLinkNoticesPath)" LogicalName="AirLink.Windows.Notices" Condition="Exists('$(AirLinkNoticesPath)')" />
    <EmbeddedResource Include="$(AirLinkHelperPath)" LogicalName="AirLink.Windows.Helper" Condition="Exists('$(AirLinkHelperPath)')" />
  </ItemGroup>
  <Target Name="RequireAirLinkHelper" BeforeTargets="Publish">
    <Error Condition="!Exists('$(AirLinkHelperPath)')" Text="Publishing requires AirLinkHelperPath pointing to the matching Go helper executable." />
    <Error Condition="!Exists('$(AirLinkNoticesPath)')" Text="Publishing requires the resolved runtime license notices embedded via AirLinkNoticesPath." />
  </Target>
</Project>
