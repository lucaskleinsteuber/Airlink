<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AirLink</AssemblyName>
    <RootNamespace>AirLink.Windows</RootNamespace>
    <Version>0.7.0</Version>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <FileVersion>0.7.0.0</FileVersion>
    <Product>AirLink</Product>
    <Description>Local, encrypted file transfers.</Description>
    <Company>lucasfd3</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/AirLink.ico</ApplicationIcon>
    <StartupObject>AirLink.Windows.Program</StartupObject>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- WPF owns per-monitor DPI through app.manifest; Windows Forms is used only for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AirLink.Core/AirLink.Core.csproj" />
    <EmbeddedResource Include="Assets/AirLink.ico" LogicalName="AirLink.Windows.Icon" />
    <EmbeddedResource Include="$(AirLinkHelperPath)" LogicalName="AirLink.Windows.Helper" Condition="Exists('$(AirLinkHelperPath)')" />
  </ItemGroup>
  <Target Name="RequireAirLinkHelper" BeforeTargets="Publish">
    <Error Condition="!Exists('$(AirLinkHelperPath)')" Text="Publishing requires AirLinkHelperPath pointing to the matching Go helper executable." />
  </Target>
</Project>
